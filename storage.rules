rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ログイン済みユーザーのみ、アルバム内の画像の読み書きを許可
    match /albums/{albumId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ログイン済みユーザーのみ、ワリカン関連ファイル（領収書・送金証明画像等）の読み書きを許可
    match /settlements/{eventId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ログイン済みユーザーのみ、アルバム内の画像の読み書きを許可
    match /albums/{albumId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ログイン済みユーザーのみ、ワリカン領収書ファイルの読み書きを許可
    match /settlements/{eventId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
